{
	"nodes":[
		{"id":"949fdd3a319f8983","type":"group","x":-1520,"y":-260,"width":520,"height":760,"label":"Map Generation"},
		{"id":"bcfe975f79c2ac37","type":"group","x":-340,"y":0,"width":480,"height":590,"label":"Map Renderer"},
		{"id":"091b9e53a6c2e815","type":"group","x":-860,"y":-340,"width":440,"height":520,"label":"Map Loader"},
		{
			"id":"152a4203f7bc98b7",
			"type":"text",
			"text":"Grabs a array of *generated* numbers OR a loaded map from *App Data* (i.e a tutorial map)",
			"styleAttributes":{"textAlign":"center"},
			"x":-840,
			"y":-320,
			"width":260,
			"height":130
		},
		{
			"id":"227df99e7a5bb9bf",
			"type":"text",
			"text":"The object is then send out as an array (use `numpy` to create and manage the arrays)",
			"styleAttributes":{"textAlign":"center"},
			"x":-1280,
			"y":-240,
			"width":260,
			"height":100
		},
		{
			"id":"f189943c7f7bf37f",
			"type":"text",
			"text":"The array is then validated to make sure that the given dimensions, tiles, etc are all matching / present",
			"styleAttributes":{"textAlign":"center"},
			"x":-710,
			"y":-140,
			"width":260,
			"height":150
		},
		{
			"id":"503226dc6760101d",
			"type":"text",
			"text":"After validation, the array is then sent off to the Map Renderer",
			"styleAttributes":{"textAlign":"center"},
			"x":-840,
			"y":60,
			"width":260,
			"height":90
		},
		{
			"id":"214493d60ddd8822",
			"type":"text",
			"text":"Different numbers correspond to different tiles\ni.e 1 = wall, 0 = nothing...",
			"styleAttributes":{
				"textAlign":"center",
				"shape":null
			},
			"x":-1410,
			"y":-65,
			"width":260,
			"height":90
		},
		{
			"id":"1fd8db8b3e1e0be4",
			"type":"text",
			"text":"The map creates random boxes (counted) and then connects them to different types of doors / hallways",
			"styleAttributes":{"textAlign":"center"},
			"x":-1280,
			"y":120,
			"width":260,
			"height":120
		},
		{
			"id":"59ff4e35d173587e",
			"type":"text",
			"text":"The map is then modified and saved with `numpy` + depending on the game mode, it could be saved as App Data",
			"styleAttributes":{"textAlign":"center"},
			"x":-1410,
			"y":340,
			"width":260,
			"height":140
		},
		{
			"id":"dcc1151ede7648bd",
			"type":"text",
			"text":"Each *box* is a Node class that generates 1 room",
			"styleAttributes":{"textAlign":"center"},
			"x":-1500,
			"y":120,
			"width":180,
			"height":120
		},
		{
			"id":"8ec33db6edf7c51f",
			"type":"text",
			"text":"Uses curses ",
			"styleAttributes":{"textAlign":"center"},
			"x":-320,
			"y":20,
			"width":260,
			"height":60
		}
	],
